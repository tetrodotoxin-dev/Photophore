module(
    name = "photophore",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "tetro_toolchain", version = "0.1.0")
archive_override(
    module_name = "tetro_toolchain",
    sha256 = "c34c2230660426abefb7344305969b72ebb7cfe119e9adeaaa81d5533c7cd1f5",
    urls = ["https://github.com/tetrodotoxin-dev/Toolchain/releases/download/v0.1.0/tetro_toolchain-0.1.0-source.tar.gz"],
)

register_toolchains("@tetro_toolchain//:cc_toolchain_for_linux_x86_64", "@tetro_toolchain//:cc_toolchain_for_wasm32", "@tetro_toolchain//:cc_toolchain_for_windows_x64")

sdks = use_extension("@tetro_toolchain//:sdk.bzl", "dependencies")
sdks.release(
    name = "perimortem",
    archives = {
        "headers": "2bb19a82ceb2dd06a122fb51142e96fd13d52fd5ed323b8a662cb640082636ed",
        "linux-x86_64-v3": "ec75376225b708cea20bc47ce90a7703a68616e79d90d3985bf297d7af4b4b0f",
        "windows-x86_64-msvc": "8b0e42f11477ade29cff8565de2aaac91ab65fe6192df10afb712e236ea9630f",
        "wasm32-emscripten": "2bc9011826736f02dfbe5177150910d57c22d3ffcee2762858f4ff604a2c2e7d",
    },
    project = "Perimortem",
    version = "0.1.0",
    deps = [],
)
use_repo(sdks, "perimortem")

bazel_dep(name = "vulkan_headers", version = "1.4.349")

# The client SDK includes its generated headers and matching runtime libraries.
# Wayland remains a private Linux dependency of the platform implementation.
wayland_sdk = use_repo_rule("@tetro_toolchain//:sdk.bzl", "debian_sdk")
wayland_sdk(
    name = "wayland",
    archives = {
        "https://deb.debian.org/debian/pool/main/w/wayland/libwayland-dev_1.23.0-1~bpo12+1_amd64.deb": "277cb77a121cdd485b63a9dd782322115762554295f1ba88551efcc950c88a27",
        "https://deb.debian.org/debian/pool/main/w/wayland/libwayland-client0_1.23.0-1~bpo12+1_amd64.deb": "0f00e0f00b8746d6a02fbe6c91708d290c26271883778c555569444f97028d9c",
        "https://deb.debian.org/debian/pool/main/libf/libffi/libffi8_3.4.4-1_amd64.deb": "6d9f6c25c30efccce6d4bceaa48ea86c329a3432abb360a141f76ac223a4c34a",
    },
    build_file = "//:source/platform/wayland/sdk.BUILD",
)
